{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "scoring64",
  "version": "0.1.2",
  "description": "Scoring64をブラウザで操作し、指定された正解・配点・部分点基準に従って答案を採点・保存します。",
  "author": {
    "name": "株式会社Fermion",
    "email": "contact@fermion.company",
    "url": "https://fermion-company.github.io/scoring64-download/"
  },
  "homepage": "https://fermion-company.github.io/scoring64-download/",
  "repository": "https://github.com/Fermion-company/scoring64-plugins",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Scoring64",
        "shortDescription": "ブラウザで答案を採点・保存",
        "longDescription": "Scoring64をブラウザで操作し、指定された正解・配点・部分点基準に従って答案を採点・保存します。 Scoring64本体と同じPCのローカルコマンド・ブラウザ操作機能、Node.js 18以上が必要です。答案の取り込みから、記述の満点・部分点・未採点の管理、結果CSVや返却PDFの保存まで進めます。教員が示した採点基準を使い、判読不能や基準不足の答案は未採点で残します。Scoring64本体の利用権限に従って操作します。AIが読む答案は利用中のAIサービスに渡る場合があります。",
        "developerName": "株式会社Fermion",
        "category": "Education & Research",
        "capabilities": [
          "答案取り込み",
          "基準に従った採点",
          "結果保存"
        ],
        "websiteURL": "https://fermion-company.github.io/scoring64-download/",
        "supportURL": "https://fermion-company.github.io/scoring64-download/contact.html",
        "privacyPolicyURL": "https://github.com/Fermion-company/scoring64-plugins/blob/main/PRIVACY.md",
        "defaultPrompt": [
          "Scoring64を起動して、この答案を指定した採点基準で採点し、結果CSVを保存してください。"
        ],
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
